# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
src-tauri/target/
src-tauri/gen/schemas/

# Local databases and logs (never commit a user's library data)
*.db
*.db-wal
*.db-shm
logs/

# ROM and disc images must never enter the repository.
# Test archives are generated at runtime into temp dirs, so there is no
# legitimate reason for any of these to appear in a commit.
*.zip
*.7z
*.rar
*.chd
*.rom
*.bin
*.cue
*.iso
*.img
*.gdi
*.a78
*.nes
*.sfc
*.smc
*.gba
*.nds
*.pbp

# BIOS, sample sets, and ROM folders
/roms/
/bios/
/samples/
/mame-roms/
/mame roms*/

# DAT definitions are user-supplied and often redistribution-restricted
*.dat
/dats/
**/dats/
mame*.xml

# Artwork and media. Anchored to the repo root so the source folders
# src/features/media/ and src-tauri/src/media/ stay tracked.
/media/
/artwork/
/box/
/screenshot/
/title/
/marquee/
/cabinet/
/video/
/manual/
/snap/

# Emulator binaries, cores, and local emulator config
/cores/
/RetroArch*/
retroarch.cfg
*.dll
*.exe

# Save data and personal emulator state
/saves/
/states/
*.state
*.srm
*.sav
*.nv
*.auto

# Editor / OS
.DS_Store
Thumbs.db
*.local
.idea/
.vscode/*
!.vscode/extensions.json

# Environment and secrets
.env
.env.*
*.pem
*.key
secrets.json
credentials.json

# Local verification artifacts
.app-screenshot.png
